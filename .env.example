POSTGRES_DB=diavoletti_dev
POSTGRES_USER=idiavoletti
POSTGRES_PASSWORD=replace_with_a_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=replace_with_a_generated_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_COOKIE_SECURE=False
APP_DOMAIN=localhost

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=replace_with_your_azure_document_intelligence_key

# Opzionali (produzione: impostati da infrastructure/compose.server.yml)
# MEDIA_USE_X_ACCEL_REDIRECT=False
# DJANGO_NUM_PROXIES=0
# DJANGO_CSRF_TRUSTED_ORIGINS=https://gestionale.example.it
# DJANGO_HSTS_SECONDS=0
# DJANGO_LOGIN_THROTTLE_RATE=10/min
